@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
@if (!Model.EstaLogueado)
{
    <div class="container" align="left" style="width:100%">
        <h3>Login - CineRenta</h3>
        <form method="POST">
            <div style="width:60%">
                <div class="form-group">
                    <label class="control-label">Usuario:</label>
                    <input asp-for="@Model.NombreUsuario" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="control-label">Contraseña:</label>
                    <input type="password" asp-for="@Model.Contrasena" class="form-control" />
                </div>
                <br />
                <input type="submit" value="Limpiar" asp-page-handler="BtClean" class="btn btn-secondary" />
                <input type="submit" value="Entrar" asp-page-handler="BtEnter" class="btn btn-primary" />
            </div>
        </form>

        <hr />
        <h3>Crear Cuenta</h3>
        <form method="POST">
            <div style="width:60%">
                <div class="form-group">
                    <label class="control-label">Usuario:</label>
                    <input asp-for="@Model.NuevoUsuario" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="control-label">Correo:</label>
                    <input asp-for="@Model.NuevoCorreo" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="control-label">Contraseña:</label>
                    <input type="password" asp-for="@Model.NuevaContrasena" class="form-control" />
                </div>
                <br />
                <input type="submit" value="Registrarse" asp-page-handler="BtRegistrar" class="btn btn-success" />
            </div>
        </form>
    </div>
}
else
{
    <div class="text-center">
        <h1 class="display-4">Bienvenido a CineRenta</h1>
        <form method="POST">
            <input type="submit" value="Cerrar Sesión" asp-page-handler="BtClose" class="btn btn-danger" />
        </form>
    </div>
}




















