@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<style>
    :root {
        --c-green: #1a5c2a;
        --c-accent: #ffd700;
        --c-surface: #ffffff;
        --c-text: #333;
        --c-border: #e0e0e0;
        --c-shadow: 0 4px 12px rgba(0,0,0,0.1);
    }

    
    .login-wrap { min-height: 80vh; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .login-card { background: white; padding: 2.5rem; border-radius: 12px; border: 1px solid var(--c-border); width: 100%; max-width: 380px; box-shadow: var(--c-shadow); }
    .btn-custom { background: white; border: 1px solid black; color: black; padding: 5px 15px; cursor: pointer; margin-right: 5px; font-weight: bold; }
    .btn-custom:hover { background: #f0f0f0; }

    
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 15px; margin-bottom: 2rem; }
    .stat-card { background: white; border: 1px solid var(--c-border); border-radius: 12px; padding: 1.5rem; text-align: center; border-top: 4px solid var(--c-green); box-shadow: var(--c-shadow); }
    .stat-num { font-size: 2.2rem; font-weight: 800; color: var(--c-green); }

   
    .catalogo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 20px; }
    .peli-card { 
        height: 240px; border-radius: 12px; position: relative; overflow: hidden; 
        display: flex; flex-direction: column; justify-content: flex-end; padding: 15px;
        box-shadow: var(--c-shadow); transition: transform 0.2s; background: #222;
    }
    .peli-card:hover { transform: scale(1.03); }
    .peli-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; opacity: 0.8; }
    .peli-info { position: relative; z-index: 2; color: white; text-shadow: 0 2px 4px rgba(0,0,0,0.9); }

 
    .rank-section { background: white; border: 1px solid var(--c-border); border-radius: 12px; overflow: hidden; margin-top: 2rem; }
    .rank-head { background: var(--c-green); color: white; padding: 15px; font-weight: bold; }
    .rank-row { display: grid; grid-template-columns: 50px 1fr auto; padding: 12px 20px; border-bottom: 1px solid var(--c-border); align-items: center; }
</style>

@if (!Model.EstaLogueado)
{
    <div class="login-wrap">
        <div class="login-logo" style="font-size:2.5rem; font-weight:800; color:var(--c-green);">🎬 Cine<span style="color:var(--c-accent)">Sayz</span></div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            <div class="alert @(ViewData["Mensaje"]!.ToString()!.Contains("exitosamente") ? "alert-success" : "alert-danger") mt-2" style="max-width:380px; width:100%;">
                @ViewData["Mensaje"]
            </div>
        }

        <!-- LOGIN -->
        <div class="login-card" id="card-login">
            <h2 style="font-size:1.5rem; margin-bottom:1.5rem;">Iniciar sesión</h2>
            <form method="post">
                <label class="fw-bold small">Usuario</label>
                <input type="text" asp-for="NombreUsuario" class="form-control mb-3" placeholder="Tu usuario" />
                <label class="fw-bold small">Contraseña</label>
                <input type="password" asp-for="Contrasena" class="form-control mb-4" placeholder="••••••••" />
                <button type="submit" asp-page-handler="BtEnter" class="btn-custom">Entrar</button>
                <button type="submit" asp-page-handler="BtClean" class="btn-custom">Limpiar</button>
            </form>
            <hr style="margin:1.2rem 0;" />
            <p class="small text-center mb-2" style="color:#666;">¿No tenés cuenta?</p>
            <button onclick="toggleRegistro()" class="w-100 btn btn-outline-success btn-sm">Registrarse</button>
        </div>

        <!-- REGISTRO -->
        <div class="login-card mt-3" id="card-registro" style="display:none;">
            <h2 style="font-size:1.5rem; margin-bottom:1.5rem;">Crear cuenta</h2>
            <form method="post">
                <label class="fw-bold small">Usuario</label>
                <input type="text" asp-for="NuevoUsuario" class="form-control mb-3" placeholder="Elige un usuario" />
                <label class="fw-bold small">Correo</label>
                <input type="email" asp-for="NuevoCorreo" class="form-control mb-3" placeholder="correo@ejemplo.com" />
                <label class="fw-bold small">Contraseña</label>
                <input type="password" asp-for="NuevaContrasena" class="form-control mb-4" placeholder="••••••••" />
                <button type="submit" asp-page-handler="BtRegistrar" class="btn btn-success w-100 mb-2">Crear cuenta</button>
            </form>
            <button onclick="toggleRegistro()" class="w-100 btn btn-outline-secondary btn-sm">← Volver al login</button>
        </div>
    </div>

    <script>
        function toggleRegistro() {
            const login = document.getElementById('card-login');
            const registro = document.getElementById('card-registro');
            login.style.display = login.style.display === 'none' ? 'block' : 'none';
            registro.style.display = registro.style.display === 'none' ? 'block' : 'none';
        }
        @if (ViewData.ContainsKey("Mensaje") && ViewData["Mensaje"]!.ToString()!.Contains("obligatorios") || ViewData.ContainsKey("Mensaje") && ViewData["Mensaje"]!.ToString()!.Contains("Cuenta"))
        {
            <text>toggleRegistro();</text>
        }
    </script>
}
else
{
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1> CineSayz 🎬</h1>
            <form method="post"><button asp-page-handler="BtClose" class="btn btn-outline-danger btn-sm">Cerrar sesión</button></form>
        </div>

        <div class="stats-grid">
            <div class="stat-card"><div class="stat-num" id="stat-peliculas">0</div><div class="small">Películas</div></div>
            <div class="stat-card"><div class="stat-num" id="stat-clientes">0</div><div class="small">Clientes</div></div>
            <div class="stat-card"><div class="stat-num" id="stat-rentas">0</div><div class="small">Rentas</div></div>
        </div>

        <h5 class="text-muted fw-bold mb-3">🎞 CATÁLOGO REAL</h5>
        <div class="catalogo-grid" id="catalogo-grid"></div>

        <div class="rank-section mt-5">
            <div class="rank-head">🏆 Top Películas Rentadas</div>
            <div id="rank-list"></div>
        </div>
    </div>

    <script>
        const API = 'http://localhost:5103';

        async function cargarTodo() {
            try {
                const [peliculas, clientes, rentas] = await Promise.all([
                    fetch(`${API}/Peliculas/ConsultarPeliculas`).then(r => r.json()),
                    fetch(`${API}/Clientes/ConsultarClientes`).then(r => r.json()),
                    fetch(`${API}/Rentas/ConsultarRentas`).then(r => r.json())
                ]);

               
                document.getElementById('stat-peliculas').innerText = peliculas.length;
                document.getElementById('stat-clientes').innerText = clientes.length;
                document.getElementById('stat-rentas').innerText = rentas.length;

              
                document.getElementById('catalogo-grid').innerHTML = peliculas.map(p => `
                    <div class="peli-card">
                        <img src="/Imagenes/${p.imagenNombre || 'default.png'}" class="peli-img" onerror="this.src='/Imagenes/default.png'">
                        <div class="peli-info">
                            <h5 class="m-0">${p.nombre}</h5>
                            <small>${p.estreno}</small>
                        </div>
                    </div>
                `).join('');

               
                document.getElementById('rank-list').innerHTML = peliculas.slice(0, 3).map((p, i) => `
                    <div class="rank-row">
                        <div class="fw-bold" style="font-size:1.5rem; color:#ccc;">${i+1}</div>
                        <div><b>${p.nombre}</b><br><small>${p.estreno}</small></div>
                        <div class="badge bg-success">Popular</div>
                    </div>
                `).join('');

            } catch (e) { console.error("Error cargando datos:", e); }
        }
        cargarTodo();
    </script>
}