@page
@model UsuariosHTMLModel
@{ ViewData["Title"] = "Usuarios"; }
<center><div class="container">
    <form method="POST" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div align="left"><h3>Gestión de Usuarios</h3></div>
        <div class="mb-3">
            <input type="submit" value="Refrescar" class="btn btn-secondary" asp-page-handler="BtRefrescar" />
            @if (HttpContext.Session.GetString("Rol") == "1")
            {
                <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" disabled="@(Model.Actual != null)" />
                <input type="submit" value="Guardar" class="btn btn-primary" asp-page-handler="BtGuardar" disabled="@(Model.Actual == null)" />
            }
        </div>
        @if (Model.Actual != null)
        {
            <input type="hidden" asp-for="Actual!.Id" />
            <input type="hidden" asp-for="Actual!.FechaRegistro" />
            <div class="card p-4 shadow-sm" style="max-width:600px;">
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label" style="text-align:left;">ID</label>
                    <div class="col-sm-8"><input class="form-control" value="@Model.Actual.Id" readonly style="background-color:#e9ecef;" /></div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label" style="text-align:left;">Usuario</label>
                    <div class="col-sm-8"><input class="form-control" asp-for="Actual!.NombreUsuario" /></div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label" style="text-align:left;">Correo</label>
                    <div class="col-sm-8"><input class="form-control" asp-for="Actual!.Correo" type="email" /></div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label" style="text-align:left;">Contraseña</label>
                    <div class="col-sm-8"><input class="form-control" asp-for="Actual!.Contrasena" type="password" /></div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label" style="text-align:left;">Rol</label>
                    <div class="col-sm-8">
                        <select class="form-control" asp-for="Actual!.Roles">
                            <option value="">-- Seleccione --</option>
                            @foreach (var r in Model.ListaRoles ?? new())
                            {
                                <option value="@r.Id" selected="@(Model.Actual!.Roles == r.Id ? "selected" : null)">@r.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label" style="text-align:left;">Fecha Registro</label>
                    <div class="col-sm-8"><input class="form-control" value="@Model.Actual.FechaRegistro.ToString("yyyy-MM-dd")" readonly style="background-color:#e9ecef;" /></div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label" style="text-align:left;">Activo</label>
                    <div class="col-sm-8 d-flex align-items-center">
                        <input type="checkbox" asp-for="Actual!.Activo" class="form-check-input ms-2" style="width:20px;height:20px;" />
                    </div>
                </div>
            </div>
        }
        @if (ViewData.ContainsKey("Mensaje")) { @await Html.PartialAsync("../Emergentes/Mensajes.cshtml") }
        @if (Model.Actual != null && Model.Borrando)
        {
            <div style="background:rgba(0,0,0,0.5);position:fixed;top:0;left:0;width:100%;height:100%;z-index:1000;">
                <div style="background:white;margin:15% auto;padding:20px;width:40%;border-radius:8px;">
                    <h2 align="left">Confirmación</h2>
                    <h6 align="left">¿Desea eliminar el usuario seleccionado?</h6>
                    <div class="mt-3">
                        <input type="submit" value="Cancelar" asp-page-handler="BtCerrar" class="btn btn-secondary" />
                        <input type="submit" value="Confirmar" asp-page-handler="BtBorrar" class="btn btn-danger" />
                    </div>
                </div>
            </div>
        }
        @if (Model.Lista != null && Model.Lista.Count > 0)
        {
            <table class="table table-striped table-bordered table-hover mt-4">
                <thead class="thead-dark">
                    <tr><th>ID</th><th>Usuario</th><th>Correo</th><th>Rol</th><th>Fecha Registro</th><th>Activo</th><th>Acciones</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Lista)
                    {
                        <tr>
                            <td>@e.Id</td>
                            <td>@e.NombreUsuario</td>
                            <td>@e.Correo</td>
                            <td>@(Model.ListaRoles?.FirstOrDefault(r => r.Id == e.Roles)?.Nombre ?? "—")</td>
                            <td>@e.FechaRegistro.ToString("yyyy-MM-dd")</td>
                            <td>@(e.Activo ? "✅" : "❌")</td>
                            <td>
                                @if (HttpContext.Session.GetString("Rol") == "1") { <input type="submit" value="Editar" asp-page-handler="BtModificar" class="btn btn-warning btn-sm" asp-route-data="@e.Id" /> }
                                @if (HttpContext.Session.GetString("Rol") == "1") { <input type="submit" value="Borrar" asp-page-handler="BtBorrarVal" class="btn btn-danger btn-sm" asp-route-data="@e.Id" /> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </form>
</div></center>
