@page
@model RolesHTMLModel
@{ ViewData["Title"] = "Roles"; }
<center><div class="container">
    <form method="POST" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div align="left"><h3>Gestión de Roles</h3></div>
        <div class="mb-3">
            <input type="submit" value="Refrescar" class="btn btn-secondary" asp-page-handler="BtRefrescar" />
            @if (HttpContext.Session.GetString("Rol") == "1")
            {
                <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" disabled="@(Model.Actual != null)" />
                <input type="submit" value="Guardar" class="btn btn-primary" asp-page-handler="BtGuardar" disabled="@(Model.Actual == null)" />
            }
        </div>
        @if (Model.Actual != null)
        {
            <input type="hidden" asp-for="Actual!.Id" />
            <div class="card p-4 shadow-sm" style="max-width:600px;">
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label" style="text-align:left;">ID</label>
                    <div class="col-sm-8"><input class="form-control" value="@Model.Actual.Id" readonly style="background-color:#e9ecef;" /></div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label" style="text-align:left;">Nombre</label>
                    <div class="col-sm-8"><input class="form-control" asp-for="Actual!.Nombre" /></div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label" style="text-align:left;">Descripción</label>
                    <div class="col-sm-8"><input class="form-control" asp-for="Actual!.Descripcion" /></div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label" style="text-align:left;">Activo</label>
                    <div class="col-sm-8 d-flex align-items-center">
                        <input type="checkbox" asp-for="Actual!.Activo" class="form-check-input ms-2" style="width:20px;height:20px;" />
                    </div>
                </div>
            </div>
        }
        @if (ViewData.ContainsKey("Mensaje")) { @await Html.PartialAsync("../Emergentes/Mensajes.cshtml") }
        @if (Model.Lista != null && Model.Lista.Count > 0)
        {
            <table class="table table-striped table-bordered table-hover mt-4">
                <thead class="thead-dark">
                    <tr><th>ID</th><th>Nombre</th><th>Descripción</th><th>Activo</th><th>Acciones</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Lista)
                    {
                        <tr>
                            <td>@e.Id</td><td>@e.Nombre</td><td>@e.Descripcion</td>
                            <td>@(e.Activo ? "✅" : "❌")</td>
                            <td>@if (HttpContext.Session.GetString("Rol") == "1") { <input type="submit" value="Editar" asp-page-handler="BtModificar" class="btn btn-warning btn-sm" asp-route-data="@e.Id" /> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </form>
</div></center>
