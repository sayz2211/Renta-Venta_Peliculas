@page
@model RepartosHTMLModel
@{
    ViewData["Title"] = "Repartos";
}
<center>
    <div class="container">
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div align="left"><h3>Gestión de Repartos</h3></div>
            <div class="mb-3">
                <input type="submit" value="Refrescar" class="btn btn-secondary" asp-page-handler="BtRefrescar" />
                <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" disabled="@(Model.Actual != null)" />
                <input type="submit" value="Guardar" class="btn btn-primary" asp-page-handler="BtGuardar" disabled="@(Model.Actual == null)" />
            </div>
            @if (Model.Actual != null)
            {
                <input type="hidden" asp-for="Actual!.Id" />
                <div class="card p-4 shadow-sm" style="max-width:600px;">
                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">ID</label>
                        <div class="col-sm-8">
                            <input class="form-control" value="@Model.Actual.Id" readonly style="background-color:#e9ecef;" />
                        </div>
                    </div>
                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">Actor</label>
                        <div class="col-sm-8">
                            <select class="form-control" asp-for="Actual!.Actores">
                                <option value="">-- Seleccione --</option>
                                @foreach (var a in Model.ListaActores ?? new())
                                {
                                    <option value="@a.Id" selected="@(Model.Actual!.Actores == a.Id ? "selected" : null)">@a.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">Película</label>
                        <div class="col-sm-8">
                            <select class="form-control" asp-for="Actual!.Peliculas">
                                <option value="">-- Seleccione --</option>
                                @foreach (var p in Model.ListaPeliculas ?? new())
                                {
                                    <option value="@p.Id" selected="@(Model.Actual!.Peliculas == p.Id ? "selected" : null)">@p.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">Personaje</label>
                        <div class="col-sm-8">
                            <input class="form-control" asp-for="Actual!.Personaje" />
                        </div>
                    </div>
                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">Rol</label>
                        <div class="col-sm-8">
                            <input class="form-control" asp-for="Actual!.Rol" />
                        </div>
                    </div>
                </div>
            }
            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            }
            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-bordered table-hover mt-4">
                    <thead class="thead-dark">
                        <tr>
                            <th>ID</th>
                            <th>Actor</th>
                            <th>Película</th>
                            <th>Personaje</th>
                            <th>Rol</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Lista)
                        {
                            <tr>
                                <td>@e.Id</td>
                                <td>@(Model.ListaActores?.FirstOrDefault(a => a.Id == e.Actores)?.Nombre ?? "")</td>
                                <td>@(Model.ListaPeliculas?.FirstOrDefault(p => p.Id == e.Peliculas)?.Nombre ?? "")</td>
                                <td>@e.Personaje</td>
                                <td>@e.Rol</td>
                                <td><input type="submit" value="Ver" asp-page-handler="BtModificar" class="btn btn-info btn-sm" asp-route-data="@e.Id" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </form>
    </div>
</center>