@page
@model APS_VR_Peliculas_Preseentacion.Pages.InventariosHTMLModel
@{
    ViewData["Title"] = "Gestión de Inventarios";
}

<center>
    <div class="container">
        <form method="POST">
            @Html.AntiForgeryToken()
            <div align="left"><h3>Gestión de Inventarios - CineRenta</h3></div>

            <div class="mb-3" align="left">
                <input type="submit" value="Refrescar" class="btn btn-secondary" asp-page-handler="BtRefrescar" />
                @if (HttpContext.Session.GetString("Rol") == "1" || HttpContext.Session.GetString("Rol") == "2")
                {
                    <input type="submit" value="Nuevo" class="btn btn-success" asp-page-handler="BtNuevo" disabled="@(Model.Actual != null)" />
                <input type="submit" value="Guardar" class="btn btn-primary" asp-page-handler="BtGuardar" disabled="@(Model.Actual == null)" />
                }
            </div>

          
            @if (Model.Actual != null)
            {
                <div class="card p-4 shadow-sm" style="max-width:700px;">
                    <input type="hidden" asp-for="Actual!.Id" />
                    
                    <div class="row">
                      
                        <div class="col-md-6">
                            <div class="form-group mb-2" style="text-align:left;">
                                <label>Película:</label>
                                <select class="form-control" asp-for="Actual!.Peliculas" required>
                                    <option value="">-- Seleccione --</option>
                                    @foreach (var p in Model.ListaPeliculas!)
                                    {
                                        <option value="@p.Id" selected="@(Model.Actual!.Peliculas == p.Id ? "selected" : null)">@p.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group mb-2" style="text-align:left;">
                                <label>Formato:</label>
                                <select class="form-control" asp-for="Actual!.Formatos" required>
                                    <option value="">-- Seleccione --</option>
                                    @foreach (var f in Model.ListaFormatos!)
                                    {
                                        <option value="@f.Id" selected="@(Model.Actual!.Formatos == f.Id ? "selected" : null)">@f.Formato - @f.Idioma</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-2" style="text-align:left;">
                                <label>Sucursal:</label>
                                <select class="form-control" asp-for="Actual!.Sucursales" required>
                                    <option value="">-- Seleccione --</option>
                                    @foreach (var s in Model.ListaSucursales!)
                                    {
                                        <option value="@s.Id" selected="@(Model.Actual!.Sucursales == s.Id ? "selected" : null)">@s.Nombre (@s.Ciudad)</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group mb-2" style="text-align:left;">
                                <label>Proveedor:</label>
                                <select class="form-control" asp-for="Actual!.Proveedores" required>
                                    <option value="">-- Seleccione --</option>
                                    @foreach (var pr in Model.ListaProveedores!)
                                    {
                                        <option value="@pr.Id" selected="@(Model.Actual!.Proveedores == pr.Id ? "selected" : null)">@pr.Nombre</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mt-2" style="text-align:left;">
                        <label>Cantidad en Existencia:</label>
                        <input type="number" class="form-control" asp-for="Actual!.Cantidad" min="0" required />
                    </div>
                </div>
            }

          
            @if (ViewData.ContainsKey("Mensaje"))
            {
                <div class="alert alert-info mt-3">@ViewData["Mensaje"]</div>
            }

           
            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-hover mt-4">
                    <thead class="thead-dark">
                        <tr>
                            <th>Película</th>
                            <th>Formato</th>
                            <th>Sucursal</th>
                            <th>Proveedor</th>
                            <th>Stock</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Lista)
                        {
                            <tr>
                                <td>@(Model.ListaPeliculas?.FirstOrDefault(p => p.Id == item.Peliculas)?.Nombre ?? item.Peliculas.ToString())</td>
                                <td>@(Model.ListaFormatos?.FirstOrDefault(f => f.Id == item.Formatos)?.Formato ?? "N/A")</td>
                                <td>@(Model.ListaSucursales?.FirstOrDefault(s => s.Id == item.Sucursales)?.Nombre ?? "N/A")</td>
                                <td>@(Model.ListaProveedores?.FirstOrDefault(pr => pr.Id == item.Proveedores)?.Nombre ?? "N/A")</td>
                                <td class="@(item.Cantidad < 5 ? "text-danger font-weight-bold" : "")">@item.Cantidad</td>
                                <td>
                                    @if (HttpContext.Session.GetString("Rol") == "1" || HttpContext.Session.GetString("Rol") == "2") { <input type="submit" value="Editar" asp-page-handler="BtModificar" asp-route-data="@item.Id" class="btn btn-info btn-sm" /> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </form>
    </div>
</center>