@page
@model ReclamosHTMLModel
@{
    ViewData["Title"] = "Reclamos";
}
<center>
    <div class="container">
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div align="left"><h3>Gestión de Reclamos</h3></div>
            <div class="mb-3">
                <input type="submit" value="Refrescar" class="btn btn-secondary" asp-page-handler="BtRefrescar" />
                @if (HttpContext.Session.GetString("Rol") == "1" || HttpContext.Session.GetString("Rol") == "2")
                {
                    <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" disabled="@(Model.Actual != null)" />
                    <input type="submit" value="Guardar" class="btn btn-primary" asp-page-handler="BtGuardar" disabled="@(Model.Actual == null)" />
                }
            </div>
            @if (Model.Actual != null)
            {
                <input type="hidden" asp-for="Actual!.Id" />
                <div class="card p-4 shadow-sm" style="max-width:600px;">
                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">ID</label>
                        <div class="col-sm-8">
                            <input class="form-control" value="@Model.Actual.Id" readonly style="background-color:#e9ecef;" />
                        </div>
                    </div>
                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">Factura</label>
                        <div class="col-sm-8">
                            <select class="form-control" asp-for="Actual!.Facturas">
                                <option value="">-- Seleccione una Factura --</option>
                                @if (Model.ListaFacturas != null)
                                {
                                    @foreach (var f in Model.ListaFacturas)
                                    {
                                        <option value="@f.Id" selected="@(Model.Actual!.Facturas == f.Id ? "selected" : null)">@f.Codigo — $@f.Total.ToString("N0")</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">Motivo</label>
                        <div class="col-sm-8">
                            <input class="form-control" asp-for="Actual!.Motivo" />
                        </div>
                    </div>
                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">Garantía</label>
                        <div class="col-sm-8">
                            <input class="form-control" asp-for="Actual!.Garantia" />
                        </div>
                    </div>
                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">Fecha</label>
                        <div class="col-sm-8">
                            <input type="date" class="form-control" asp-for="Actual!.Fecha" />
                        </div>
                    </div>
                </div>
            }
            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            }
            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-bordered table-hover mt-4">
                    <thead class="thead-dark">
                        <tr>
                            <th>ID</th>
                            <th>Factura</th>
                            <th>Motivo</th>
                            <th>Garantía</th>
                            <th>Fecha</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Lista)
                        {
                            <tr>
                                <td>@e.Id</td>
                                <td>@(Model.ListaFacturas?.FirstOrDefault(f => f.Id == e.Facturas)?.Codigo ?? ("Factura #" + e.Facturas))</td>
                                <td>@e.Motivo</td>
                                <td>@e.Garantia</td>
                                <td>@e.Fecha.ToString("yyyy-MM-dd")</td>
                                <td><input type="submit" value="Ver" asp-page-handler="BtModificar" class="btn btn-info btn-sm" asp-route-data="@e.Id" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </form>
    </div>
</center>
