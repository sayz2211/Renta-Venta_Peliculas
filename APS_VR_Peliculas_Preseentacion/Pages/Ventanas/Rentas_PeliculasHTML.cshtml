@page
@model Rentas_PeliculasHTMLModel
@{
    ViewData["Title"] = "Rentas Películas";
}
<center>
    <div class="container">
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div align="left"><h3>Gestión de Rentas Películas</h3></div>
            <div class="mb-3">
                <input type="submit" value="Refrescar" class="btn btn-secondary" asp-page-handler="BtRefrescar" />
                <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" disabled="@(Model.Actual != null)" />
                <input type="submit" value="Guardar" class="btn btn-primary" asp-page-handler="BtGuardar" disabled="@(Model.Actual == null)" />
                @if (HttpContext.Session.GetString("Rol") == "1")
                {
                    <input type="submit" value="Exportar PDF" class="btn btn-danger" asp-page-handler="BtPDF" />
                }
            </div>

            @if (Model.Actual != null)
            {
                <input type="hidden" asp-for="Actual!.Id" />
                <div class="card p-4 shadow-sm" style="max-width:600px;">
                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">ID</label>
                        <div class="col-sm-8">
                            <input class="form-control" value="@Model.Actual.Id" readonly style="background-color:#e9ecef;" />
                        </div>
                    </div>

                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">Renta</label>
                        <div class="col-sm-8">
                            <select class="form-control" asp-for="Actual!.Rentas" id="txtRenta">
                                <option value="">-- Seleccione --</option>
                                @if (Model.ListaRentas != null)
                                {
                                    @foreach (var r in Model.ListaRentas)
                                    {
                                        <option value="@r.Id" selected="@(Model.Actual!.Rentas == r.Id ? "selected" : null)">Renta #@r.Id - @r.Fecha_Renta.ToString("yyyy-MM-dd")</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">Película</label>
                        <div class="col-sm-8">
                            <select class="form-control" asp-for="Actual!.Peliculas" id="txtPelicula">
                                <option value="">-- Seleccione --</option>
                                @if (Model.ListaPeliculas != null)
                                {
                                    @foreach (var p in Model.ListaPeliculas)
                                    {
                                        <option value="@p.Id" selected="@(Model.Actual!.Peliculas == p.Id ? "selected" : null)">@p.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">Cantidad</label>
                        <div class="col-sm-8">
                            <input class="form-control" asp-for="Actual!.Cantidad" id="txtCantidad" type="number" />
                        </div>
                    </div>

                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">Días</label>
                        <div class="col-sm-8">
                            <input class="form-control" asp-for="Actual!.Dias" id="txtDias" type="number" />
                        </div>
                    </div>

                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">Precio por Día</label>
                        <div class="col-sm-8">
                            <input class="form-control" asp-for="Actual!.Precio_Dia" id="txtPrecio" type="number" step="0.01" />
                        </div>
                    </div>

                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">Subtotal</label>
                        <div class="col-sm-8">
                            <input type="hidden" asp-for="Actual!.Subtotal" id="hidSubtotal" />
                            <input class="form-control" id="txtSubtotal" value="@Model.Actual.Subtotal" readonly style="background-color:#e9ecef;" />
                        </div>
                    </div>
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            }

            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-bordered table-hover mt-4">
                    <thead class="thead-dark">
                        <tr>
                            <th>ID</th>
                            <th>Renta</th>
                            <th>Película</th>
                            <th>Cant.</th>
                            <th>Días</th>
                            <th>Precio Día</th>
                            <th>Subtotal</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Lista)
                        {
                            <tr>
                                <td>@e.Id</td>
                                <td>Renta #@e.Rentas</td>
                                <td>@(Model.ListaPeliculas?.FirstOrDefault(p => p.Id == e.Peliculas)?.Nombre ?? e.Peliculas.ToString())</td>
                                <td>@e.Cantidad</td>
                                <td>@e.Dias</td>
                                <td>@e.Precio_Dia.ToString("C0")</td>
                                <td class="font-weight-bold">@e.Subtotal.ToString("C0")</td>
                                <td><input type="submit" value="Ver" asp-page-handler="BtModificar" class="btn btn-info btn-sm" asp-route-data="@e.Id" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </form>
    </div>
</center>

<script>
    document.addEventListener("input", function () {
        const cant = parseFloat(document.getElementById("txtCantidad")?.value) || 0;
        const dias = parseFloat(document.getElementById("txtDias")?.value) || 0;
        const precio = parseFloat(document.getElementById("txtPrecio")?.value) || 0;
        const subtotal = (cant * dias * precio).toFixed(2);
        const subtotalField = document.getElementById("txtSubtotal");
        const hidSubtotal = document.getElementById("hidSubtotal");
        if (subtotalField) subtotalField.value = subtotal;
        if (hidSubtotal) hidSubtotal.value = subtotal;
    });
</script>