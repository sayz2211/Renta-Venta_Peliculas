@page
@model FacturasHTMLModel
@{
    ViewData["Title"] = "Facturas";
}
<center>
    <div class="container">
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div align="left"><h3>Gestión de Facturas</h3></div>
            <div class="mb-3">
                <input type="submit" value="Refrescar" class="btn btn-secondary" asp-page-handler="BtRefrescar" />                @if (HttpContext.Session.GetString("Rol") == "1" || HttpContext.Session.GetString("Rol") == "2")
                {

                <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" disabled="@(Model.Actual != null)" />
                <input type="submit" value="Guardar" class="btn btn-primary" asp-page-handler="BtGuardar" disabled="@(Model.Actual == null)" />
                }
                @if (HttpContext.Session.GetString("Rol") == "1")
                {
                    <input type="submit" value="Exportar PDF" class="btn btn-danger" asp-page-handler="BtPDF" />
                }

            </div>
            @if (Model.Actual != null)
            {
                <input type="hidden" asp-for="Actual!.Id" />
                <div class="card p-4 shadow-sm" style="max-width:600px;">
                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">ID</label>
                        <div class="col-sm-8">
                            <input class="form-control" value="@Model.Actual.Id" readonly style="background-color:#e9ecef;" />
                        </div>
                    </div>
                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">Código</label>
                        <div class="col-sm-8">
                            <input class="form-control" asp-for="Actual!.Codigo" placeholder="Se genera automáticamente" />
                        </div>
                    </div>
                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">Cliente</label>
                        <div class="col-sm-8">
                            <select class="form-control" asp-for="Actual!.Clientes">
                                <option value="">-- Seleccione --</option>
                                @if (Model.ListaClientes != null)
                                {
                                    @foreach (var c in Model.ListaClientes)
                                    {
                                        <option value="@c.Id" selected="@(Model.Actual!.Clientes == c.Id ? "selected" : null)">@c.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">Renta</label>
                        <div class="col-sm-8">
                            <select class="form-control" asp-for="Actual!.Rentas">
                                <option value="0">-- Sin renta --</option>
                                @if (Model.ListaRentas != null)
                                {
                                    @foreach (var r in Model.ListaRentas)
                                    {
                                        <option value="@r.Id" selected="@(Model.Actual!.Rentas == r.Id ? "selected" : null)">Renta #@r.Id - @r.Fecha_Renta.ToString("yyyy-MM-dd")</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">Venta</label>
                        <div class="col-sm-8">
                            <select class="form-control" asp-for="Actual!.Ventas">
                                <option value="0">-- Sin venta --</option>
                                @if (Model.ListaVentas != null)
                                {
                                    @foreach (var v in Model.ListaVentas)
                                    {
                                        <option value="@v.Id" selected="@(Model.Actual!.Ventas == v.Id ? "selected" : null)">Venta #@v.Id - $@v.Precio_Venta</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">Descuento</label>
                        <div class="col-sm-8">
                            <select class="form-control" asp-for="Actual!.Descuentos">
                                <option value="0">-- Sin descuento --</option>
                                @if (Model.ListaDescuentos != null)
                                {
                                    @foreach (var d in Model.ListaDescuentos)
                                    {
                                        <option value="@d.Id" selected="@(Model.Actual!.Descuentos == d.Id ? "selected" : null)">@d.Descripcion (@d.Porcentaje%)</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-group row mb-2">
                        <label class="col-sm-4 col-form-label" style="text-align:left;">Total</label>
                        <div class="col-sm-8">
                            <input class="form-control" asp-for="Actual!.Total" />
                        </div>
                    </div>
                </div>
            }
            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            }
            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-bordered table-hover mt-4">
                    <thead class="thead-dark">
                        <tr>
                            <th>ID</th>
                            <th>Código</th>
                            <th>Cliente</th>
                            <th>Total</th>
                            <th>Fecha</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Lista)
                        {
                            <tr>
                                <td>@e.Id</td>
                                <td>@e.Codigo</td>
                                <td>@(Model.ListaClientes?.FirstOrDefault(c => c.Id == e.Clientes)?.Nombre ?? e.Clientes.ToString())</td>
                                <td>@e.Total</td>
                                <td>@e.Fecha.ToString("yyyy-MM-dd")</td>
                                <td>@if (HttpContext.Session.GetString("Rol") == "1" || HttpContext.Session.GetString("Rol") == "2") { <input type="submit" value="Ver" asp-page-handler="BtModificar" class="btn btn-info btn-sm" asp-route-data="@e.Id" /> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </form>
    </div>
</center>
