@page
@model Formatos_PeliculasHTMLModel
@{ ViewData["Title"] = "Formatos Películas"; }
<center><div class="container">
    <form method="POST" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div align="left"><h3>Gestión de Formatos Películas</h3></div>
        <div class="mb-3">
            <input type="submit" value="Refrescar" class="btn btn-secondary" asp-page-handler="BtRefrescar" />
            @if (HttpContext.Session.GetString("Rol") == "1" || HttpContext.Session.GetString("Rol") == "2")
            {
                <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" disabled="@(Model.Actual != null)" />
                <input type="submit" value="Guardar" class="btn btn-primary" asp-page-handler="BtGuardar" disabled="@(Model.Actual == null)" />
            }
            @if (HttpContext.Session.GetString("Rol") == "1")
            {
                <input type="submit" value="Exportar PDF" class="btn btn-danger" asp-page-handler="BtPDF" />
            }
        </div>
        @if (Model.Actual != null)
        {
            <input type="hidden" asp-for="Actual!.Id" />
            <div class="card p-4 shadow-sm" style="max-width:600px;">
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label" style="text-align:left;">ID</label>
                    <div class="col-sm-8"><input class="form-control" value="@Model.Actual.Id" readonly style="background-color:#e9ecef;" /></div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label" style="text-align:left;">Película</label>
                    <div class="col-sm-8">
                        <select class="form-control" asp-for="Actual!.Peliculas">
                            <option value="">-- Seleccione --</option>
                            @foreach (var p in Model.ListaPeliculas ?? new())
                            {
                                <option value="@p.Id" selected="@(Model.Actual!.Peliculas == p.Id ? "selected" : null)">@p.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label" style="text-align:left;">Formato</label>
                    <div class="col-sm-8">
                        <select class="form-control" asp-for="Actual!.Formatos">
                            <option value="">-- Seleccione --</option>
                            @foreach (var f in Model.ListaFormatos ?? new())
                            {
                                <option value="@f.Id" selected="@(Model.Actual!.Formatos == f.Id ? "selected" : null)">@f.Formato — @f.Idioma</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label" style="text-align:left;">Inventario</label>
                    <div class="col-sm-8">
                        <select class="form-control" asp-for="Actual!.Inventarios">
                            <option value="">-- Sin inventario --</option>
                            @foreach (var i in Model.ListaInventarios ?? new())
                            {
                                <option value="@i.Id" selected="@(Model.Actual!.Inventarios == i.Id ? "selected" : null)">Inv. #@i.Id — Cant: @i.Cantidad</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-group row mb-2">
                    <label class="col-sm-4 col-form-label" style="text-align:left;">Precio Formato</label>
                    <div class="col-sm-8"><input class="form-control" asp-for="Actual!.Precio_Formato" type="number" step="0.01" /></div>
                </div>
            </div>
        }
        @if (ViewData.ContainsKey("Mensaje")) { @await Html.PartialAsync("../Emergentes/Mensajes.cshtml") }
        @if (Model.Lista != null && Model.Lista.Count > 0)
        {
            <table class="table table-striped table-bordered table-hover mt-4">
                <thead class="thead-dark">
                    <tr><th>ID</th><th>Película</th><th>Formato</th><th>Inventario</th><th>Precio Formato</th><th>Acciones</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Lista)
                    {
                        <tr>
                            <td>@e.Id</td>
                            <td>@(Model.ListaPeliculas?.FirstOrDefault(p => p.Id == e.Peliculas)?.Nombre ?? "—")</td>
                            <td>@(Model.ListaFormatos?.FirstOrDefault(f => f.Id == e.Formatos)?.Formato ?? "—")</td>
                            <td>@(e.Inventarios != null ? "Inv. #" + e.Inventarios : "—")</td>
                            <td>@e.Precio_Formato.ToString("C0")</td>
                            <td>@if (HttpContext.Session.GetString("Rol") == "1" || HttpContext.Session.GetString("Rol") == "2") { <input type="submit" value="Editar" asp-page-handler="BtModificar" class="btn btn-warning btn-sm" asp-route-data="@e.Id" /> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </form>
</div></center>
